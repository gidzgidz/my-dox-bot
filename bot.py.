        bot.send_message(
            message.chat.id,
            "⚠️ *Важно!*\n\n"
            "Это официальный канал бота.\n"
            "Здесь вся инфа о боте и важные новости.\n"
            "Не пропусти!\n\n"
            "Подпишись: @xozsj",
            reply_markup=subscribe_menu(),
            parse_mode="Markdown"
        )
        return

    bot.send_message(
        message.chat.id,
        "👋 Привет!\n\n"
        "Это FlewKill — твой универсальный бот-помощник.\n\n"
        "📄 Выбери, что тебе нужно 👇",
        reply_markup=main_menu()
